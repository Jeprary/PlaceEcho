{
  "name": "@placeecho/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "world:build-spz": "node scripts/build-world-spz.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "node --experimental-strip-types --test tests/integration/*.test.ts tests/e2e/*.test.ts",
    "verify": "pnpm typecheck && pnpm build && pnpm test"
  },
  "dependencies": {
    "@placeecho/shared": "workspace:*",
    "@sparkjsdev/spark": "^2.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0"
  }
}
